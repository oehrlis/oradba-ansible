---
# yamllint configuration compatible with ansible-lint (production profile)
extends: default

ignore: |
  .venv/
  .collections/
  .ansible/
  .cache/
  dist/

rules:
  line-length:
    max: 120
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
